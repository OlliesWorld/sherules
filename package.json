{
	"name": "sherules",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
		"snapshot": "tsx scripts/snapshot.ts",
		"db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
		"ask": "tsx --env-file-if-exists=.env scripts/ask.ts",
		"eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
		"logs": "tsx --env-file-if-exists=.env scripts/logs.ts",
		"test": "tsx --test src/lib/server/agent-search.test.ts src/lib/server/voice.test.ts src/lib/server/citations.test.ts src/lib/server/glossary.test.ts src/lib/server/guess-league.test.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "7.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vite": "8.3.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@google/genai": "2.32.0",
		"@libsql/client": "0.18.0",
		"@lucide/svelte": "1.77.0",
		"@upstash/redis": "1.41.0",
		"clsx": "2.1.1",
		"livekit-client": "2.25.0",
		"livekit-server-sdk": "2.20.1",
		"mode-watcher": "1.1.0",
		"redis": "6.3.1",
		"tailwind-merge": "3.7.1",
		"tailwind-variants": "3.3.1",
		"tw-animate-css": "1.4.0",
		"unpdf": "2.2.1"
	}
}
