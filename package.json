{
	"name": "sherules",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
		"db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
		"ask": "tsx --env-file-if-exists=.env scripts/ask.ts",
		"logs": "tsx --env-file-if-exists=.env scripts/logs.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@google/genai": "^2.28.0",
		"@libsql/client": "^0.18.0",
		"@lucide/svelte": "^1.55.0",
		"@upstash/redis": "^1.39.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"unpdf": "^1.8.1"
	}
}
