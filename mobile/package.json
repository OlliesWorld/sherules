{
	"name": "sherules-mobile",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5174 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"imports": {
		"#lib/*": "./shared/*",
		"#mobile/*": "./src/lib/*"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"mode-watcher": "1.1.0",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vite": "8.3.8"
	},
	"dependencies": {
		"@capacitor/browser": "8.0.5",
		"@capacitor/core": "8.6.2",
		"@capacitor/preferences": "8.0.1",
		"@fontsource/archivo": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/sora": "5.3.0"
	}
}
