# Copy to .env (gitignored) for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead.

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local dev: a file next to package.json. Deploy: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:local.db
# Only needed for Turso Cloud. The deployed app only reads, so production can use a
# read-only token; ingest needs a full-access one (keep that one local).
TURSO_AUTH_TOKEN=

# Upstash Redis: question log and daily limits. Vercel's Redis integration sets these.
# Optional locally; required in production (without it, questions are turned away).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret for hashing visitor IPs in the daily limits. Required in production.
# Generate one with: openssl rand -hex 32
RATE_LIMIT_SECRET=
